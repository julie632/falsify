# Copy to deploy/.env on the deployment machine and review available resources.
# This file contains no credentials. Do not add Codex tokens or API keys.
FALSIFY_IMAGE=falsify-lab:0.1.0
FALSIFY_CODEX_VERSION=0.158.0-alpha.2.1
FALSIFY_HOST_PORT=18765
FALSIFY_CPUS=1.0
FALSIFY_MEMORY_LIMIT=1g

# The host Caddy service needs its OWN private environment configuration.
# These are documented here, not injected into the application container.
# Use an actual domain pointing at the droplet, with HTTPS ports available.
# FALSIFY_DOMAIN=falsify.example.com
# FALSIFY_BASIC_AUTH_USER=your_chosen_username
# FALSIFY_BASIC_AUTH_HASH='PASTE_A_FRESH_CADDY_BCRYPT_HASH_HERE'
# Generate the hash interactively using: caddy hash-password
